{
  "name": "timer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxlint --fix . && oxfmt --write .",
    "check": "pnpm check:types && pnpm lint",
    "check:types": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
