{
  "name": "timer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "check:dependencies": "ncu --target patch --errorLevel 2",
    "check:audit": "pnpm audit --audit-level high",
    "update:dependencies": "ncu -u && pnpm install",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxlint --fix . && oxfmt --write .",
    "check": "pnpm check:types && pnpm lint",
    "check:types": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@vite-pwa/astro": "^1.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "^23.0.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18"
    }
  }
}
