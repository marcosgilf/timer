---
/**
 * The big readable clock face: progress bar, digits, phase word.
 * Properties in only — it renders whatever the page sets on it via `data-` attributes and has no
 * behaviour of its own.
 */
---

<div class="display" data-display>
  <div class="bar"><span data-bar></span></div>
  <span class="digits" data-digits role="timer" aria-live="off">00:00</span>
  <span class="phase" data-phase-word></span>
</div>

<style>
  .display {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin: 1rem 0;
    max-width: 100%;
  }

  .bar {
    width: 100%;
    height: 0.75rem;
    background: var(--line);
    border-radius: 1rem;
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--phase-colour, var(--fg));
  }

  .digits {
    /* "05:00" is ~2.7em wide in tabular figures, so the vw factor must stay under 100/2.7 to fit. */
    font-size: clamp(4rem, 26vw, 14rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--phase-colour, var(--fg));
  }

  .phase {
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--muted);
    min-height: 1.4em;
  }

  /* Colour carries the Phase; the word carries it for anyone who cannot see the colour. */
  :global(body[data-phase="work"]) {
    --phase-colour: var(--work);
  }

  :global(body[data-phase="rest"]) {
    --phase-colour: var(--rest);
  }

  :global(body[data-phase="prepare"]) {
    --phase-colour: var(--prepare);
  }
</style>
