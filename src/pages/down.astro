---
import AppBar from "../components/AppBar.astro";
import TimerDisplay from "../components/TimerDisplay.astro";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Down Timer">
  <main>
    <AppBar title="Timer" backHref="/" backLabel="Up" actionHref="/configuration" />
    <TimerDisplay />

    <p class="wake-lock-error" data-wake-lock-error role="alert" hidden></p>
    <p class="audio-note" data-audio-note hidden>Tap Start to enable sound.</p>

    <p class="phase-status" data-phase-status data-phase="work" aria-live="polite">
      <strong data-phase-kind>Work</strong>
      <span>Round <span data-round>1</span> of <span data-total-rounds>1</span></span>
      <span data-next-phase></span>
    </p>

    <p class="finished" data-finished aria-hidden="true">
      Done: <span data-completed-rounds>1</span> of <span data-summary-rounds>1</span> rounds
    </p>

    <div class="controls">
      <button type="button" data-action="primary">Start</button>
      <button type="button" data-action="reset">Reset</button>
    </div>

    <p class="visually-hidden" role="status" data-announcer></p>
  </main>
</AppLayout>

<script>
  import { elapsedMs, isRunning, pause, reset, resume, start, stopped } from "../domain/clock.ts";
  import type { Clock } from "../domain/clock.ts";
  import { announceElapsed, formatRemaining } from "../domain/format.ts";
  import {
    clampRounds,
    countdown,
    DEFAULT_DURATION_MS,
    durationFromParts,
  } from "../domain/routine.ts";
  import { phaseAt } from "../domain/phase.ts";
  import { createCompletionSound } from "../client/completion-sound.ts";
  import { createScreenWakeLock, type ScreenWakeLockManager } from "../client/wake-lock.ts";

  const params = new URLSearchParams(location.search);
  const workMinutes = params.get("workMinutes") ?? params.get("minutes");
  const workSeconds = params.get("workSeconds") ?? params.get("seconds");
  const hasWorkDuration = workMinutes !== null || workSeconds !== null;
  const durationMs = hasWorkDuration
    ? durationFromParts(Number(workMinutes ?? 0), Number(workSeconds ?? 0))
    : DEFAULT_DURATION_MS;
  const restMs = params.has("restMinutes") || params.has("restSeconds")
    ? durationFromParts(Number(params.get("restMinutes") ?? 0), Number(params.get("restSeconds") ?? 0), true)
    : 0;
  const rounds = clampRounds(Number(params.get("rounds") ?? 1));
  const routine = countdown(durationMs, restMs, rounds);
  const totalDurationMs = (routine.durationMs + routine.restMs) * routine.rounds;
  const startsDone = params.has("done");

  const display = document.querySelector<HTMLTimeElement>("[data-display]")!;
  const minutes = document.querySelector<HTMLElement>("[data-minutes]")!;
  const seconds = document.querySelector<HTMLElement>("[data-seconds]")!;
  const primary = document.querySelector<HTMLButtonElement>('[data-action="primary"]')!;
  const resetButton = document.querySelector<HTMLButtonElement>('[data-action="reset"]')!;
  const finished = document.querySelector<HTMLElement>("[data-finished]")!;
  const phaseStatus = document.querySelector<HTMLElement>("[data-phase-status]")!;
  const phaseKind = document.querySelector<HTMLElement>("[data-phase-kind]")!;
  const round = document.querySelector<HTMLElement>("[data-round]")!;
  const totalRounds = document.querySelector<HTMLElement>("[data-total-rounds]")!;
  const nextPhase = document.querySelector<HTMLElement>("[data-next-phase]")!;
  const completedRounds = document.querySelector<HTMLElement>("[data-completed-rounds]")!;
  const summaryRounds = document.querySelector<HTMLElement>("[data-summary-rounds]")!;
  const announcer = document.querySelector<HTMLElement>("[data-announcer]")!;
  const wakeLockError = document.querySelector<HTMLElement>("[data-wake-lock-error]")!;
  const audioNote = document.querySelector<HTMLElement>("[data-audio-note]")!;
  const configurationLink = document.querySelector<HTMLAnchorElement>(".app-bar-action a")!;
  const completionSound = createCompletionSound();

  let clock: Clock = stopped;
  let isFinished = startsDone;
  let frame = 0;
  let pageTitle = "";
  let soundRequest = 0;

  const wakeLock = createScreenWakeLock(
    () => {
      if (!("wakeLock" in navigator)) return undefined;
      return (navigator as Navigator & { wakeLock: ScreenWakeLockManager }).wakeLock;
    },
    () => !document.hidden,
    () => {
      if (isRunning(clock) && !document.hidden) void refreshWakeLock();
    },
  );

  const refreshWakeLock = async () => {
    if (!isRunning(clock) || document.hidden) return;
    const result = await wakeLock.acquire();
    if (!isRunning(clock) || document.hidden) return;
    if (typeof result === "object" && result.status === "failed") {
      wakeLockError.textContent = `Wake Lock error: ${String(result.error)}`;
      wakeLockError.hidden = false;
    }
    if (result === "acquired" || result === "unsupported") {
      wakeLockError.textContent = "";
      wakeLockError.hidden = true;
    }
  };

  const releaseWakeLock = () => {
    wakeLockError.textContent = "";
    wakeLockError.hidden = true;
    void wakeLock.release();
  };

  const cancelSound = () => {
    soundRequest += 1;
    completionSound.cancel();
    audioNote.hidden = true;
  };

  const scheduleSound = (resumeExisting = false) => {
    const request = ++soundRequest;
    const remainingMs = totalDurationMs - elapsedMs(clock, Date.now());
    const schedule = resumeExisting ? completionSound.resume(remainingMs) : completionSound.start(remainingMs);
    void schedule.then((enabled) => {
      if (request !== soundRequest || isFinished || !isRunning(clock)) return;
      audioNote.hidden = enabled;
    });
  };

  const announce = (message: string) => {
    announcer.textContent = message;
  };

  const setUrlState = (state: "running" | "paused" | "done") => {
    const url = new URL(location.href);
    url.searchParams.delete("paused");
    url.searchParams.delete("done");
    if (state !== "running") url.searchParams.set(state, "true");
    history.replaceState(null, "", url);
  };

  const labelPhase = (kind: string) => kind.charAt(0).toUpperCase() + kind.slice(1);

  const render = () => {
    const state = isFinished ? phaseAt(totalDurationMs, routine) : phaseAt(elapsedMs(clock, Date.now()), routine);
    const visible = formatRemaining(state.remainingInPhaseMs);
    const [mm, ss] = visible.split(":");
    const currentPhase = isFinished ? "done" : state.phaseKind;
    minutes.textContent = mm;
    seconds.textContent = ss;
    display.dateTime = `PT${state.remainingInPhaseMs / 1000}S`;
    display.setAttribute("aria-label", isFinished ? "Done" : `${labelPhase(state.phaseKind)}, ${announceElapsed(Math.ceil(state.remainingInPhaseMs / 1000) * 1000)}`);
    phaseStatus.dataset.phase = currentPhase;
    phaseKind.textContent = labelPhase(currentPhase);
    round.textContent = String(state.round);
    totalRounds.textContent = String(state.totalRounds);
    nextPhase.textContent = state.nextPhaseKind && state.nextPhaseKind !== "done" ? `Next: ${labelPhase(state.nextPhaseKind)}` : "";
    completedRounds.textContent = String(state.round);
    summaryRounds.textContent = String(state.totalRounds);
    const status = isFinished ? "Done" : isRunning(clock) ? "Running" : clock.startedAt === null ? "" : "Paused";
    document.body.dataset.routineActive = String(!isFinished && clock.startedAt !== null);
    const phaseLabel = isFinished ? "Done" : `${labelPhase(state.phaseKind)} · Round ${state.round} of ${state.totalRounds}`;
    const nextTitle = status ? `${status} · ${phaseLabel} · ${visible} - Timer` : `${visible} - Timer`;
    if (nextTitle !== pageTitle) {
      pageTitle = nextTitle;
      document.title = nextTitle;
    }
    finished.dataset.visible = String(isFinished);
    finished.setAttribute("aria-hidden", String(!isFinished));
    return state;
  };

  const stopTicking = () => {
    cancelAnimationFrame(frame);
    frame = 0;
  };

  const finish = () => {
    isFinished = true;
    clock = pause(clock, Date.now());
    completionSound.complete();
    audioNote.hidden = true;
    releaseWakeLock();
    stopTicking();
    setUrlState("done");
    announce(`Done. ${routine.rounds} ${routine.rounds === 1 ? "round" : "rounds"} completed.`);
    paint();
    window.dispatchEvent(new Event("timer:counter-inactive"));
  };

  const paint = () => {
    const state = render();
    if (state.status === "done" && !isFinished) finish();
    primary.textContent = isFinished ? "Start again" : isRunning(clock) ? "Pause" : clock.startedAt === null ? "Start" : "Resume";
  };

  const tick = () => {
    if (!isRunning(clock)) return;
    const state = render();
    if (state.status === "done") {
      finish();
      return;
    }
    frame = requestAnimationFrame(tick);
  };

  const startRunning = () => {
    isFinished = false;
    setUrlState("running");
    clock = start(reset(), Date.now());
    scheduleSound();
    void refreshWakeLock();
    stopTicking();
    announce(
      `Started. ${announceElapsed(routine.durationMs)} work${routine.restMs > 0 ? `, ${announceElapsed(routine.restMs)} rest` : ""}, ${routine.rounds} ${routine.rounds === 1 ? "round" : "rounds"}.`,
    );
    paint();
    tick();
  };

  primary.addEventListener("click", () => {
    if (isFinished) {
      startRunning();
      return;
    }

    const now = Date.now();
    if (isRunning(clock)) {
      clock = pause(clock, now);
      cancelSound();
      releaseWakeLock();
      setUrlState("paused");
      stopTicking();
      announce(`Paused at ${announceElapsed(Math.ceil(elapsedMs(clock, now) / 1000) * 1000)}.`);
      paint();
      return;
    }

    if (clock.startedAt === null) {
      startRunning();
      return;
    }

    clock = resume(clock, now);
    scheduleSound();
    void refreshWakeLock();
    setUrlState("running");
    announce("Resumed.");
    paint();
    tick();
  });

  resetButton.addEventListener("click", () => {
    setUrlState("running");
    clock = reset();
    isFinished = false;
    cancelSound();
    releaseWakeLock();
    stopTicking();
    announce("Reset.");
    paint();
    window.dispatchEvent(new Event("timer:counter-inactive"));
  });

  const configurationUrl = new URL("/configuration", location.origin);
  configurationUrl.search = new URLSearchParams({
    minutes: String(Math.floor(routine.durationMs / 60_000)),
    seconds: String(Math.floor(routine.durationMs / 1000) % 60),
    restMinutes: String(Math.floor(routine.restMs / 60_000)),
    restSeconds: String(Math.floor(routine.restMs / 1000) % 60),
    rounds: String(routine.rounds),
  }).toString();
  configurationLink.href = `${configurationUrl.pathname}${configurationUrl.search}`;

  document.addEventListener("visibilitychange", () => {
    paint();
    if (document.hidden) {
      releaseWakeLock();
      return;
    }
    if (isRunning(clock)) {
      scheduleSound(true);
      void refreshWakeLock();
      stopTicking();
      tick();
    }
  });

  let confirmedNavigation = false;
  document.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (document.body.dataset.routineActive !== "true" || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!window.confirm("Leave the active Routine?")) {
        event.preventDefault();
        return;
      }
      confirmedNavigation = true;
      cancelSound();
      releaseWakeLock();
    });
  });

  window.addEventListener("beforeunload", (event) => {
    if (document.body.dataset.routineActive !== "true" || confirmedNavigation) return;
    event.preventDefault();
  });

  window.addEventListener("pagehide", () => {
    cancelSound();
    releaseWakeLock();
  });

  paint();
</script>
