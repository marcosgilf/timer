---
import AppLayout from "../layouts/AppLayout.astro";
import { formatElapsed } from "../domain/format.ts";
---

<AppLayout title="Timer">
  <main>
    <h1>Timer</h1>

    <!-- <time> is the element for a duration; datetime carries the machine-readable value. -->
    <time datetime="PT0S" data-display>{formatElapsed(0)}</time>

    <div class="controls">
      <button type="button" data-action="primary">Start</button>
      <button type="button" class="secondary" data-action="reset" hidden>Reset</button>
    </div>

    <!--
      The digits are deliberately NOT a live region: announcing every second makes a screen reader
      unusable. State changes are announced here instead, with the time spoken as words.
    -->
    <p class="visually-hidden" role="status" data-announcer></p>
  </main>
</AppLayout>

<script>
  import { elapsedMs, isRunning, pause, reset, resume, start, stopped } from "../domain/clock.ts";
  import type { Clock } from "../domain/clock.ts";
  import { announceElapsed, formatElapsed } from "../domain/format.ts";

  const display = document.querySelector<HTMLTimeElement>("[data-display]")!;
  const primary = document.querySelector<HTMLButtonElement>('[data-action="primary"]')!;
  const resetButton = document.querySelector<HTMLButtonElement>('[data-action="reset"]')!;
  const announcer = document.querySelector<HTMLElement>("[data-announcer]")!;

  let clock: Clock = stopped;
  let frame = 0;

  const render = () => {
    const ms = elapsedMs(clock, Date.now());
    display.textContent = formatElapsed(ms);
    display.dateTime = `PT${Math.floor(ms / 1000)}S`;
    // The hours string is much wider, so it is sized differently. See src/styles/app.css.
    display.toggleAttribute("data-hours", ms >= 3_600_000);
  };

  /** One frame loop, always cancelled before another starts. */
  const tick = () => {
    render();
    frame = requestAnimationFrame(tick);
  };

  const stopTicking = () => {
    cancelAnimationFrame(frame);
    frame = 0;
  };

  const announce = (message: string) => {
    announcer.textContent = message;
  };

  const paint = () => {
    const running = isRunning(clock);
    primary.textContent = running ? "Pause" : clock.startedAt === null ? "Start" : "Resume";
    // Reset is only offered once there is something to reset, and never while running.
    resetButton.hidden = running || clock.startedAt === null;
    render();
  };

  primary.addEventListener("click", () => {
    if (isRunning(clock)) {
      clock = pause(clock, Date.now());
      stopTicking();
      announce(`Paused at ${announceElapsed(elapsedMs(clock, Date.now()))}`);
    } else {
      clock = clock.startedAt === null ? start(clock, Date.now()) : resume(clock, Date.now());
      announce(clock.pausedTotalMs === 0 ? "Started" : "Resumed");
      stopTicking();
      tick();
    }
    paint();
  });

  resetButton.addEventListener("click", () => {
    clock = reset(clock);
    stopTicking();
    announce("Reset");
    paint();
    // Focus would otherwise be lost when this button hides itself.
    primary.focus();
  });

  // rAF is throttled or paused in a hidden tab; the time is derived from the wall clock, so a single
  // repaint on return is enough to be correct again.
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden && isRunning(clock)) render();
  });

  paint();
</script>
