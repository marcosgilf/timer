---
import AppBar from "../components/AppBar.astro";
import TimerDisplay from "../components/TimerDisplay.astro";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="00:00 - Timer">
  <main>
    <AppBar title="Timer" actionHref="/configuration" />
    <TimerDisplay />

    <p class="finished" data-finished aria-hidden="true">Done: <time data-finished-time>99:59</time></p>

    <div class="controls">
      <button type="button" data-action="primary">Start</button>
      <button type="button" data-action="reset">Reset</button>
    </div>

    <!-- The digits are not live: per-second announcements make a screen reader unusable. -->
    <p class="visually-hidden" role="status" data-announcer></p>
  </main>
</AppLayout>

<script>
  import { elapsedMs, isRunning, pause, reset, resume, start, stopped } from "../domain/clock.ts";
  import type { Clock } from "../domain/clock.ts";
  import { announceElapsed, formatElapsed, MAX_ELAPSED_MS } from "../domain/format.ts";
  import { chrono } from "../domain/routine.ts";
  import { phaseAt } from "../domain/phase.ts";

  const display = document.querySelector<HTMLTimeElement>("[data-display]")!;
  const minutes = document.querySelector<HTMLElement>("[data-minutes]")!;
  const seconds = document.querySelector<HTMLElement>("[data-seconds]")!;
  const primary = document.querySelector<HTMLButtonElement>('[data-action="primary"]')!;
  const resetButton = document.querySelector<HTMLButtonElement>('[data-action="reset"]')!;
  const finished = document.querySelector<HTMLElement>("[data-finished]")!;
  const finishedTime = document.querySelector<HTMLTimeElement>("[data-finished-time]")!;
  const announcer = document.querySelector<HTMLElement>("[data-announcer]")!;

  const startsDone = new URLSearchParams(location.search).has("done");
  let clock: Clock = stopped;
  let isFinished = startsDone;
  let frame = 0;

  const announce = (message: string) => {
    announcer.textContent = message;
  };

  const setUrlState = (state: "running" | "paused" | "done") => {
    const url = new URL(location.href);
    url.searchParams.delete("paused");
    url.searchParams.delete("done");
    if (state !== "running") url.searchParams.set(state, "true");
    history.replaceState(null, "", url);
  };

  const render = () => {
    const state = phaseAt(elapsedMs(clock, Date.now()), chrono());
    const visible = formatElapsed(state.displayMs);
    const [mm, ss] = visible.split(":");
    minutes.textContent = mm;
    seconds.textContent = ss;
    display.dateTime = `PT${state.displayMs / 1000}S`;
    display.setAttribute("aria-label", announceElapsed(state.displayMs));
    document.title = isFinished ? `Done - ${formatElapsed(MAX_ELAPSED_MS)} - Timer` : `${visible} - Timer`;
    finished.dataset.visible = String(isFinished);
    finished.setAttribute("aria-hidden", String(!isFinished));
    finishedTime.textContent = formatElapsed(MAX_ELAPSED_MS);
    finishedTime.dateTime = `PT${MAX_ELAPSED_MS / 1000}S`;
    return state;
  };

  const stopTicking = () => {
    cancelAnimationFrame(frame);
    frame = 0;
  };

  const finish = () => {
    isFinished = true;
    clock = pause(clock, Date.now());
    stopTicking();
    setUrlState("done");
    announce(`Done: ${announceElapsed(MAX_ELAPSED_MS)}.`);
    paint();
  };

  const paint = () => {
    const state = render();
    if (state.status === "done" && !isFinished) finish();
    primary.textContent = isFinished ? "Start again" : isRunning(clock) ? "Pause" : clock.startedAt === null ? "Start" : "Resume";
  };

  const tick = () => {
    if (!isRunning(clock)) return;
    const state = render();
    if (state.status === "done") {
      finish();
      return;
    }
    frame = requestAnimationFrame(tick);
  };

  const startRunning = () => {
    isFinished = false;
    setUrlState("running");
    clock = start(reset(), Date.now());
    stopTicking();
    announce("Started.");
    paint();
    tick();
  };

  primary.addEventListener("click", () => {
    if (isFinished) {
      startRunning();
      return;
    }

    const now = Date.now();
    if (isRunning(clock)) {
      clock = pause(clock, now);
      setUrlState("paused");
      stopTicking();
      announce(`Paused at ${announceElapsed(elapsedMs(clock, now))}.`);
      paint();
      return;
    }

    if (clock.startedAt === null) {
      startRunning();
      return;
    }

    clock = resume(clock, now);
    setUrlState("running");
    announce("Resumed.");
    paint();
    tick();
  });

  resetButton.addEventListener("click", () => {
    setUrlState("running");
    clock = reset();
    isFinished = false;
    stopTicking();
    announce("Reset.");
    paint();
  });

  document.addEventListener("visibilitychange", () => {
    if (!document.hidden && isRunning(clock)) {
      stopTicking();
      tick();
    }
  });

  paint();
</script>
