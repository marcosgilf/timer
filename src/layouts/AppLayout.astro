---
/**
 * App shell. Pico CSS classless: semantic elements are the design system, so this file adds a
 * container and nothing else.
 */
import "@picocss/pico/css/pico.classless.min.css";
import packageJson from "../../package.json";
import "../styles/app.css";

const { title } = Astro.props as { title: string };
const version = packageJson.version;
const deployContext = import.meta.env.PUBLIC_DEPLOY_CONTEXT ?? (import.meta.env.DEV ? "local" : "production");
const prNumber = import.meta.env.PUBLIC_PR_NUMBER;
const shortSha = import.meta.env.PUBLIC_COMMIT_SHA?.slice(0, 7);
const deployLabel =
  deployContext === "preview" && prNumber
    ? `PR #${prNumber}${shortSha ? ` · ${shortSha}` : ""}`
    : deployContext === "production"
      ? ""
      : shortSha
        ? `${deployContext} · ${shortSha}`
        : deployContext;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Track tasks, workouts or run pomodoros." />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {deployLabel && <small class="deploy-clue" aria-label={`Deployment context ${deployLabel}`}>{deployLabel}</small>}
    <small class="app-version" aria-label={`Timer version ${version}`}>v{version}</small>

    <script>
      import { registerSW } from "virtual:pwa-register";

      registerSW();
    </script>
  </body>
</html>
