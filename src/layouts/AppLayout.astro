---
/**
 * App shell. Pico CSS classless: semantic elements are the design system, so this file adds a
 * container and nothing else.
 */
import "@picocss/pico/css/pico.classless.min.css";
import packageJson from "../../package.json";
import "../styles/app.css";

const { title } = Astro.props as { title: string };
const version = packageJson.version;
const deployContext = import.meta.env.PUBLIC_DEPLOY_CONTEXT ?? (import.meta.env.DEV ? "local" : "production");
const prNumber = import.meta.env.PUBLIC_PR_NUMBER;
const shortSha = import.meta.env.PUBLIC_COMMIT_SHA?.slice(0, 7);
const deployLabel =
  deployContext === "preview" && prNumber
    ? `PR #${prNumber}${shortSha ? ` · ${shortSha}` : ""}`
    : deployContext === "production"
      ? ""
      : shortSha
        ? `${deployContext} · ${shortSha}`
        : deployContext;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Track tasks, workouts or run pomodoros." />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body data-routine-active="false">
    <slot />
    <button type="button" class="update-control" data-update-control hidden>Reload to update</button>
    <footer class="app-footer">
      {deployLabel && <small class="deploy-clue" aria-label={`Deployment context ${deployLabel}`}>{deployLabel}</small>}
      <small class="app-version" aria-label={`Timer version ${version}`}>v{version}</small>
    </footer>

    <script>
      import { registerSW } from "virtual:pwa-register";
      import { createPwaUpdateController, type RegisterSW } from "../client/pwa-update.ts";

      const updateControl = document.querySelector<HTMLButtonElement>("[data-update-control]")!;
      const registerServiceWorker: RegisterSW = (options) => registerSW(options);
      const update = createPwaUpdateController({
        registerSW: registerServiceWorker,
        isRoutineActive: () => document.body.dataset.routineActive === "true",
        confirmLeave: () => window.confirm("Leave the active Routine and reload?"),
        onUpdateReady: () => {
          updateControl.hidden = false;
        },
        onActivationConfirmed: () => {
          document.body.dataset.navigationConfirmed = "true";
        },
        onActivationFailed: () => {
          delete document.body.dataset.navigationConfirmed;
        },
      });

      updateControl.addEventListener("click", () => {
        void update.activate();
      });
      update.register();
    </script>
  </body>
</html>
