---
/**
 * App shell. Pico CSS classless: semantic elements are the design system, so this file adds a
 * container and nothing else.
 */
import "@picocss/pico/css/pico.classless.min.css";
import "../styles/app.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Track tasks, workouts or run pomodoros." />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <dialog data-update-prompt aria-labelledby="update-title">
      <article>
        <h2 id="update-title">Update ready</h2>
        <p>A new version is available.</p>
        <footer>
          <button type="button" data-update-dismiss>Later</button>
          <button type="button" data-update-reload>Reload</button>
        </footer>
      </article>
    </dialog>

    <script>
      import { registerSW } from "virtual:pwa-register";

      const prompt = document.querySelector<HTMLDialogElement>("[data-update-prompt]")!;
      const reload = document.querySelector<HTMLButtonElement>("[data-update-reload]")!;
      const dismiss = document.querySelector<HTMLButtonElement>("[data-update-dismiss]")!;

      const updateSW = registerSW({
        onNeedRefresh() {
          prompt.showModal();
        },
      });

      reload.addEventListener("click", () => updateSW(true));
      dismiss.addEventListener("click", () => prompt.close());
    </script>
  </body>
</html>
